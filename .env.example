# Contact form delivery. The /api/contact route POSTs each submission as JSON
# to this URL (Zapier / Make / Zoho Flow / Slack workflow / your own endpoint).
# Unset in production = the form returns an error instead of silently dropping leads.
CONTACT_WEBHOOK_URL=

# Optional: overrides the public origin (default https://stackstudio.co.za), e.g. to point
# QR codes and business cards at a staging site or a tunnel while testing.
NEXT_PUBLIC_SITE_URL=
